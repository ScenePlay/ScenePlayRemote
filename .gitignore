.env
*.db
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
routers/__pycache__/

# Runtime media staged by the local ScenePlay box — never source. Ignore the
# whole directories (per-extension patterns kept missing .jpeg/.gif uploads);
# .gitkeep stays tracked so the dirs exist on a fresh clone.
portal/battlemaps/*
!portal/battlemaps/.gitkeep
portal/monsters/*
!portal/monsters/.gitkeep
portal/textures/*
!portal/textures/.gitkeep
portal/portraits/*
!portal/portraits/.gitkeep
audio_debug.log
