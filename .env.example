# Copy this file to .env and fill in real values before running locally.
# .env is git-ignored — never commit secrets.

RELAY_SECRET=change-me-gm-secret
JWT_SECRET=change-me-jwt-secret
DATABASE_URL=sqlite:///./relay.db
# PORT=8000

# ── Optional: WLED-over-MQTT bridge ───────────────────────────────────────────
# Lets players' home WLED strips follow the DM's lighting WITHOUT the browser
# having to reach a plain-HTTP LAN device (blocked on Firefox/Safari, fragile
# on Chrome). Point these at any MQTT broker the relay AND the players' WLEDs
# can reach; unset MQTT_HOST to disable the feature entirely.
#   - Own broker (recommended): mosquitto on any VPS; per-player passwords via
#     mosquitto_passwd. Render can't host raw-TCP services, so the broker
#     lives elsewhere even if the relay runs on Render.
#   - Zero-setup testing: test.mosquitto.org or broker.hivemq.com (PUBLIC —
#     anyone can read/write your topics; set an unguessable MQTT_TOPIC_PREFIX).
# Note: stock WLED firmware speaks MQTT without TLS, so player traffic to the
# broker is cleartext on 1883 — fine for lighting commands, so don't reuse a
# password that matters. MQTT_TLS only secures the relay→broker leg.
# MQTT_HOST=broker.example.com
# MQTT_PORT=1883
# MQTT_USERNAME=sceneplay-relay
# MQTT_PASSWORD=change-me
# MQTT_TLS=0
# MQTT_TOPIC_PREFIX=sceneplay
# MQTT_PUBLIC_HOST=            # what players type into WLED (default: MQTT_HOST)
# MQTT_PUBLIC_PORT=            # (default: MQTT_PORT)
